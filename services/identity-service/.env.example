SERVICE_NAME=identity-service
LOG_LEVEL=info

# --- Required: Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sporekart_identity
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Required: JWT ---
APP_JWT_SECRET=replace-with-at-least-32-byte-secret
APP_JWT_ISSUER=https://identity.sporekart.com
APP_JWT_EXPIRATION_MINUTES=15
APP_JWT_REFRESH_EXPIRATION_MINUTES=10080
APP_JWT_CLOCK_SKEW_SECONDS=30

# --- Optional: Redis ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# --- Optional: Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Optional: CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Profiles ---
SPRING_PROFILES_ACTIVE=dev
