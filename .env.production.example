# SporeKart — Production Environment Configuration Template
# Copy to .env.production and fill in actual values

NODE_ENV=production
LOG_LEVEL=warn

# Supabase Authentication (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# API Endpoints (REQUIRED)
VITE_API_BASE_URL=https://api.sporekart.com
VITE_IDENTITY_SERVICE=https://identity.sporekart.com
VITE_CATALOG_SERVICE=https://catalog.sporekart.com
VITE_CART_SERVICE=https://cart.sporekart.com
VITE_ORDER_SERVICE=https://orders.sporekart.com
VITE_PAYMENT_SERVICE=https://payment.sporekart.com
VITE_NOTIFICATION_SERVICE=https://notifications.sporekart.com
VITE_INVENTORY_SERVICE=https://inventory.sporekart.com
VITE_FULFILLMENT_SERVICE=https://fulfillment.sporekart.com
VITE_SEARCH_SERVICE=https://search.sporekart.com
VITE_ANALYTICS_SERVICE=https://analytics.sporekart.com
VITE_AI_SERVICE=https://ai.sporekart.com
VITE_CONTENT_SERVICE=https://content.sporekart.com
VITE_RISK_SERVICE=https://risk.sporekart.com
VITE_SUPPORT_SERVICE=https://support.sporekart.com
VITE_ADMIN_SERVICE=https://admin.sporekart.com
VITE_TRAINING_SERVICE=https://training.sporekart.com

# Stripe (REQUIRED)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key

# Sentry (REQUIRED)
VITE_SENTRY_DSN=https://your-dsn@sentry.sporekart.com/0
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature Flags
VITE_FF_MOCK_MODE=false
VITE_FF_PRODUCTION_MODE=true
VITE_FF_PAYMENT_GATEWAY=stripe
VITE_FF_SHIPPING_PROVIDER=shiprocket
VITE_FF_EMAIL_PROVIDER=sendgrid
VITE_FF_SMS_PROVIDER=twilio
VITE_FF_STORAGE_PROVIDER=s3
VITE_FF_AUTH_PROVIDER=supabase
