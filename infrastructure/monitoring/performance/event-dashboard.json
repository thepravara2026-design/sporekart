{
  "__inputs": [],
  "__requires": [],
  "title": "SporeKart Event Backbone Performance",
  "uid": "sporekart-event-perf",
  "panels": [
    {
      "title": "Event Throughput",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "rate(event_published_total[1m])", "legendFormat": "published"},
        {"expr": "rate(event_consumed_total[1m])", "legendFormat": "consumed"}
      ]
    },
    {
      "title": "Publish Latency",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(event_publish_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(event_publish_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"unit": "s"}
    },
    {
      "title": "Dispatch Latency",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(event_dispatch_duration_seconds_bucket[5m]))", "legendFormat": "p95"}
      ],
      "fieldConfig": {"unit": "s"}
    },
    {
      "title": "Handler Execution Latency",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(event_handler_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{handler}}"}
      ],
      "fieldConfig": {"unit": "s"}
    },
    {
      "title": "Dead Letter Queue",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {"expr": "rate(event_dlq_total[1m])", "legendFormat": "DLQ"}
      ]
    },
    {
      "title": "Event Distribution by Type",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {"expr": "rate(event_published_total[5m])", "legendFormat": "{{type}}"}
      ]
    },
    {
      "title": "Retry Count",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {"expr": "rate(event_retries_total[1m])", "legendFormat": "retries"}
      ]
    },
    {
      "title": "Concurrent Events",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [
        {"expr": "event_concurrent_processing", "legendFormat": "concurrent"}
      ]
    },
    {
      "title": "Consumer Lag",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "event_consumer_lag", "legendFormat": "{{consumer}}"}
      ]
    },
    {
      "title": "Replay Events",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "rate(event_replay_total[1m])", "legendFormat": "replayed"}
      ]
    },
    {
      "title": "Handler Success Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {"expr": "rate(event_handler_success_total[5m]) / (rate(event_handler_success_total[5m]) + rate(event_handler_failure_total[5m]))",
         "legendFormat": "success rate"}
      ],
      "fieldConfig": {"unit": "percentunit"}
    },
    {
      "title": "Avg Processing Time by Handler",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {"expr": "topk(10, event_handler_avg_duration_seconds)", "legendFormat": "{{handler}}"}
      ],
      "fieldConfig": {"unit": "s"}
    }
  ],
  "schemaVersion": 30
}
