<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="sporekart"/>
    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <springProperty name="ACTIVE_PROFILE" source="spring.profiles.active" defaultValue="development"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <fieldName>@timestamp</fieldName>
                </timestamp>
                <message/>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <logLevel>
                    <fieldName>severity</fieldName>
                </logLevel>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>correlationId</includeMdcKeyName>
                    <includeMdcKeyName>requestId</includeMdcKeyName>
                    <includeMdcKeyName>workspaceId</includeMdcKeyName>
                    <includeMdcKeyName>userId</includeMdcKeyName>
                    <includeMdcKeyName>method</includeMdcKeyName>
                    <includeMdcKeyName>path</includeMdcKeyName>
                    <includeMdcKeyName>status</includeMdcKeyName>
                    <includeMdcKeyName>duration</includeMdcKeyName>
                    <includeMdcKeyName>remoteAddr</includeMdcKeyName>
                    <includeMdcKeyName>service</includeMdcKeyName>
                </mdc>
                <contextName>
                    <fieldName>service</fieldName>
                </contextName>
                <callerData>
                    <classFieldName>class</classFieldName>
                    <methodFieldName>method</methodFieldName>
                    <lineFieldName>line</lineFieldName>
                </callerData>
                <stackTrace>
                    <fieldName>stacktrace</fieldName>
                    <maxDepth>50</maxDepth>
                </stackTrace>
                <nestedField>
                    <fieldName>event</fieldName>
                    <providers>
                        <pattern>
                            <pattern>
                                {
                                "application": "${APP_NAME}",
                                "environment": "${ACTIVE_PROFILE}",
                                "event_type": "application_log"
                                }
                            </pattern>
                        </pattern>
                    </providers>
                </nestedField>
            </providers>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.json</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <fieldName>@timestamp</fieldName>
                </timestamp>
                <message/>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <logLevel>
                    <fieldName>severity</fieldName>
                </logLevel>
                <mdc/>
                <contextName>
                    <fieldName>service</fieldName>
                </contextName>
                <callerData/>
                <stackTrace>
                    <fieldName>stacktrace</fieldName>
                    <maxDepth>50</maxDepth>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <springProfile name="development">
        <root level="INFO">
            <appender-ref ref="ASYNC_CONSOLE"/>
        </root>
        <logger name="com.sporekart" level="DEBUG"/>
    </springProfile>

    <springProfile name="staging">
        <root level="INFO">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
        <logger name="com.sporekart" level="DEBUG"/>
        <logger name="org.springframework" level="WARN"/>
    </springProfile>

    <springProfile name="production">
        <root level="WARN">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
        <logger name="com.sporekart" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="io.micrometer" level="INFO"/>
        <logger name="org.hibernate" level="WARN"/>
    </springProfile>
</configuration>
