{"title":"Active Users","type":"stat","gridPos":{"h":4,"w":3,"x":9,"y":0},"targets":[{"expr":"sporekart_business_users_active"}]},
{"title":"Orders Today","type":"stat","gridPos":{"h":4,"w":3,"x":12,"y":0},"targets":[{"expr":"increase(sporekart_business_orders_created[24h])"}]},
