{"title":"Provider Latency","type":"graph","gridPos":{"h":8,"w":8,"x":16,"y":0},"targets":[{"expr":"histogram_quantile(0.95, rate(sporekart_ai_provider_latency_seconds_bucket[5m]))","legendFormat":"{{provider}}"}]},
