{"title":"SporeKart Infrastructure","uid":"sporekart-infra","panels":[
{"title":"Cluster CPU Usage","type":"graph","gridPos":{"h":8,"w":8,"x":0,"y":0},"targets":[{"expr":"sum(rate(container_cpu_usage_seconds_total[5m])) by (pod)","legendFormat":"{{pod}}"}]},
{"title":"Cluster Memory Usage","type":"graph","gridPos":{"h":8,"w":8,"x":8,"y":0},"targets":[{"expr":"sum(container_memory_working_set_bytes) by (pod)","legendFormat":"{{pod}}"}]},
{"title":"Cluster Network IO","type":"graph","gridPos":{"h":8,"w":8,"x":16,"y":0},"targets":[{"expr":"sum(rate(container_network_receive_bytes_total[5m])) by (pod)","legendFormat":"rx {{pod}}"},{"expr":"sum(rate(container_network_transmit_bytes_total[5m])) by (pod)","legendFormat":"tx {{pod}}"}]},
{"title":"Node Status","type":"table","gridPos":{"h":8,"w":8,"x":0,"y":8},"targets":[{"expr":"kube_node_status_condition","legendFormat":"{{node}}"}]},
{"title":"Pod Distribution by Node","type":"bargauge","gridPos":{"h":8,"w":8,"x":8,"y":8},"targets":[{"expr":"count(kube_pod_info) by (node)","legendFormat":"{{node}}"}]},
{"title":"Container Restarts","type":"graph","gridPos":{"h":8,"w":8,"x":16,"y":8},"targets":[{"expr":"rate(kube_pod_container_status_restarts_total[1h])","legendFormat":"{{pod}}"}]},
{"title":"Disk Usage","type":"graph","gridPos":{"h":8,"w":8,"x":0,"y":16},"targets":[{"expr":"kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes","legendFormat":"{{namespace}}"}]},
{"title":"Service Endpoints","type":"table","gridPos":{"h":8,"w":8,"x":8,"y":16},"targets":[{"expr":"kube_endpoint_address_available","legendFormat":"{{endpoint}}"}]},
{"title":"Certificate Expiry","type":"table","gridPos":{"h":8,"w":8,"x":16,"y":16},"targets":[{"expr":"certmanager_certificate_expiry_seconds","legendFormat":"{{name}}"}]},
{"title":"Ingress Traffic","type":"graph","gridPos":{"h":8,"w":12,"x":0,"y":24},"targets":[{"expr":"sum(rate(nginx_ingress_controller_requests[5m])) by (ingress)","legendFormat":"{{ingress}}"}]},
{"title":"Ingress Latency","type":"graph","gridPos":{"h":8,"w":12,"x":12,"y":24},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"},{"expr":"histogram_quantile(0.99, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p99"}]}],"schemaVersion":30}
