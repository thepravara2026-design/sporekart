{"title":"SporeKart Engineering Overview","uid":"sporekart-eng","panels":[
{"title":"Request Rate by Service","type":"graph","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count[5m])) by (service)","legendFormat":"{{service}}"}]},
{"title":"Error Rate by Service","type":"graph","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (service) / sum(rate(http_server_requests_seconds_count[5m])) by (service)","legendFormat":"{{service}}"}]},
{"title":"P95 Latency by Service","type":"graph","gridPos":{"h":8,"w":8,"x":0,"y":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le, service))","legendFormat":"{{service}}"}]},
{"title":"P99 Latency by Service","type":"graph","gridPos":{"h":8,"w":8,"x":8,"y":8},"targets":[{"expr":"histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le, service))","legendFormat":"{{service}}"}]},
{"title":"CPU by Service","type":"graph","gridPos":{"h":8,"w":8,"x":16,"y":8},"targets":[{"expr":"avg(process_cpu_usage) by (service)","legendFormat":"{{service}}"}]},
{"title":"Memory by Service","type":"graph","gridPos":{"h":8,"w":8,"x":0,"y":16},"targets":[{"expr":"avg(jvm_memory_used_bytes{area=\"heap\"}) by (service) / avg(jvm_memory_max_bytes{area=\"heap\"}) by (service)","legendFormat":"{{service}}"}]},
{"title":"GC Pause by Service","type":"graph","gridPos":{"h":8,"w":8,"x":8,"y":16},"targets":[{"expr":"rate(jvm_gc_pause_seconds_sum[5m])","legendFormat":"{{service}}"}]},
{"title":"Thread Count by Service","type":"graph","gridPos":{"h":8,"w":8,"x":16,"y":16},"targets":[{"expr":"jvm_threads_live","legendFormat":"{{service}}"}]},
{"title":"DB Connection Pool","type":"graph","gridPos":{"h":8,"w":8,"x":0,"y":24},"targets":[{"expr":"hikaricp_connections_active","legendFormat":"active {{pool}}"},{"expr":"hikaricp_connections_idle","legendFormat":"idle {{pool}}"},{"expr":"hikaricp_connections_pending","legendFormat":"pending {{pool}}"}]},
{"title":"Cache Hit Ratio","type":"graph","gridPos":{"h":8,"w":8,"x":8,"y":24},"targets":[{"expr":"rate(cache_hits_total[5m]) / (rate(cache_hits_total[5m]) + rate(cache_misses_total[5m]))","legendFormat":"{{cache}}"}]},
{"title":"Deployment Frequency","type":"stat","gridPos":{"h":4,"w":4,"x":16,"y":24},"targets":[{"expr":"count(changeset)"}],"description":"Deployments this week"},
{"title":"Change Failure Rate","type":"stat","gridPos":{"h":4,"w":4,"x":20,"y":24},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1h])) / sum(rate(http_server_requests_seconds_count[1h]))"}],"fieldConfig":{"unit":"percentunit"}}],"schemaVersion":30}
