{
  "expo": {
    "name": "SporeKart Dealer",
    "slug": "sporekart-dealer",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.sporekart.dealer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sporekart.dealer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2ecc71"
        }
      ],
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow SporeKart to scan barcodes"
        }
      ]
    ]
  }
}
