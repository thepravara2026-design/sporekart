      "inputHeight": {
        "sm": { "value": "36px", "type": "dimension" },
        "md": { "value": "40px", "type": "dimension", "description": "Default input height" },
        "lg": { "value": "48px", "type": "dimension" }
      },
      "tableRowHeight": {
        "compact": { "value": "36px", "type": "dimension" },
        "comfortable": { "value": "48px", "type": "dimension", "description": "Default table row" }
      }
    },
    "container": {
      "prose": { "value": "720px", "type": "dimension" },
      "data": { "value": "1200px", "type": "dimension" },
      "full": { "value": "100%", "type": "dimension" }
    }
