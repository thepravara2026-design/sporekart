# SporeKart — Staging Environment Configuration
# Sprint E (Production Hardening) — P0-04

NODE_ENV=production
LOG_LEVEL=debug

# Supabase Authentication
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_ANON_KEY=staging-supabase-anon-key

# API Endpoints
VITE_API_BASE_URL=https://staging-api.sporekart.com
VITE_IDENTITY_SERVICE=https://staging-identity.sporekart.com
VITE_CATALOG_SERVICE=https://staging-catalog.sporekart.com
VITE_CART_SERVICE=https://staging-cart.sporekart.com
VITE_ORDER_SERVICE=https://staging-orders.sporekart.com
VITE_PAYMENT_SERVICE=https://staging-payment.sporekart.com
VITE_NOTIFICATION_SERVICE=https://staging-notifications.sporekart.com
VITE_INVENTORY_SERVICE=https://staging-inventory.sporekart.com
VITE_FULFILLMENT_SERVICE=https://staging-fulfillment.sporekart.com
VITE_SEARCH_SERVICE=https://staging-search.sporekart.com
VITE_ANALYTICS_SERVICE=https://staging-analytics.sporekart.com
VITE_AI_SERVICE=https://staging-ai.sporekart.com
VITE_CONTENT_SERVICE=https://staging-content.sporekart.com
VITE_RISK_SERVICE=https://staging-risk.sporekart.com
VITE_SUPPORT_SERVICE=https://staging-support.sporekart.com
VITE_ADMIN_SERVICE=https://staging-admin.sporekart.com
VITE_TRAINING_SERVICE=https://staging-training.sporekart.com

# Stripe (Test Mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_staging_stripe_key

# Sentry
VITE_SENTRY_DSN=https://staging-dsn@sentry.sporekart.com/0
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_TRACES_SAMPLE_RATE=0.5

# Feature Flags
VITE_FF_MOCK_MODE=false
VITE_FF_PRODUCTION_MODE=false
VITE_FF_PAYMENT_GATEWAY=stripe
VITE_FF_SHIPPING_PROVIDER=shiprocket
VITE_FF_EMAIL_PROVIDER=sendgrid
VITE_FF_SMS_PROVIDER=twilio
VITE_FF_STORAGE_PROVIDER=s3
VITE_FF_AUTH_PROVIDER=supabase
