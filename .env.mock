# =====================================================================================
# MOCK MODE ENVIRONMENT
# Strictly for QA testing — NO production services attached
# =====================================================================================
NODE_ENV=mock
MOCK_MODE=true
LOG_LEVEL=debug

# Mock Database
MOCK_DATABASE_URL=mongodb://localhost:27017/sporekart-mock

# Mock Authentication
MOCK_AUTH_ENABLED=true
MOCK_AUTH_TOKEN=mock-token-sporekart-qa

# Mock API Endpoints
MOCK_API_BASE_URL=http://localhost:5173/api
MOCK_IDENTITY_SERVICE=http://localhost:8081
MOCK_CATALOG_SERVICE=http://localhost:8082
MOCK_CART_SERVICE=http://localhost:8083
MOCK_ORDER_SERVICE=http://localhost:8084
MOCK_PAYMENT_SERVICE=http://localhost:8085
MOCK_NOTIFICATION_SERVICE=http://localhost:8086
MOCK_INVENTORY_SERVICE=http://localhost:8087
MOCK_FULFILLMENT_SERVICE=http://localhost:8088
MOCK_SEARCH_SERVICE=http://localhost:8089
MOCK_ANALYTICS_SERVICE=http://localhost:8090
MOCK_AI_SERVICE=http://localhost:8091
MOCK_CONTENT_SERVICE=http://localhost:8092
MOCK_RISK_SERVICE=http://localhost:8093
MOCK_SUPPORT_SERVICE=http://localhost:8094
MOCK_ADMIN_SERVICE=http://localhost:8095
MOCK_TRAINING_SERVICE=http://localhost:8096

# Mock Razorpay (Payment)
MOCK_RAZORPAY_KEY_ID=rzp_mock_test_key
MOCK_RAZORPAY_KEY_SECRET=mock_razorpay_secret

# Mock Shiprocket (Shipping)
MOCK_SHIPROCKET_API_KEY=mock_shiprocket_key
MOCK_SHIPROCKET_EMAIL=qa@sporekart.mock

# Mock Email
MOCK_EMAIL_ENABLED=true
MOCK_EMAIL_FROM=qa@sporekart.mock

# Mock SMS
MOCK_SMS_ENABLED=true
MOCK_SMS_PROVIDER=mock

# Mock Storage
MOCK_STORAGE_PROVIDER=local
MOCK_STORAGE_BUCKET=sporekart-mock

# Mock Analytics
MOCK_ANALYTICS_PROVIDER=local

# Feature Flags (Mock Mode)
FF_MOCK_MODE=true
FF_PRODUCTION_MODE=false
FF_PAYMENT_GATEWAY=mock
FF_SHIPPING_PROVIDER=mock
FF_EMAIL_PROVIDER=mock
FF_SMS_PROVIDER=mock
FF_STORAGE_PROVIDER=local
FF_AUTH_PROVIDER=mock

# QA Configuration
QA_MODE=true
QA_TEST_TIMEOUT=30000
QA_RETRIES=2
QA_VIDEO_RECORDING=on
QA_TRACE_RECORDING=on
QA_SCREENSHOT_MODE=on
