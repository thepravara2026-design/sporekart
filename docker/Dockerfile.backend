# SporeKart — Backend Service Production Dockerfile
# Enterprise container with health probes, resource labels, and security hardening

FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    if [ -d "shared-platform" ] && [ -f "shared-platform/pom.xml" ]; then \
      cd shared-platform && ../apache-maven-3.9.9/bin/mvn install -DskipTests -q; \
    fi; \
    for svc in services/*/; do \
      if [ -f "$${svc}pom.xml" ]; then \
        cd "$${svc}" && ../../apache-maven-3.9.9/bin/mvn package -DskipTests -q -Pquality; \
        cd ../..; \
      fi; \
    done

FROM eclipse-temurin:21-jre-alpine AS runtime
RUN addgroup -S sporekart && adduser -S sporekart -G sporekart && \
    apk add --no-cache wget curl
WORKDIR /app
ARG SERVICE=gateway-service
COPY --from=builder /build/services/${SERVICE}/target/*.jar app.jar
RUN chown -R sporekart:sporekart /app
USER sporekart
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError" \
    MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true \
    MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
  CMD wget -qO- http://localhost:8080/actuator/health/liveness || exit 1
LABEL com.sporekart.service="${SERVICE}" \
      com.sporekart.version="2.0.0" \
      com.sporekart.managed-by="terraform"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
