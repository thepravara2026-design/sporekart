{"type":"frame-snapshot","snapshot":{"callId":"call@132","snapshotName":"before@call@132","pageId":"page@f32ae3ef94b6f85db83a3e8302af95fd","frameId":"frame@d1c23fd2a61d5455bf53368cb1cb8024","frameUrl":"http://localhost:5174/login","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},[[1,0]],[[1,1]],[[1,2]],[[1,3]],[[1,4]],[[1,5]],[[1,6]],[[1,7]],[[1,9]],[[1,10]],[[1,12]],[[1,14]],["STYLE",{},"/* ==========================================================================\n   SporeKart — Authentication Experience\n   Phase 6 · Sprint 21 · Part 7\n   --------------------------------------------------------------------------\n   Styles are built ONLY on the Enterprise Design Tokens (see tokens/global.css).\n   No custom color, spacing, or typography values are introduced.\n   Responsive down to 320px. Honors prefers-reduced-motion.\n   ========================================================================== */\n\n.auth-shell {\n  display: grid;\n  grid-template-columns: minmax(340px, 0.92fr) 1.08fr;\n  min-height: 100vh;\n  background: var(--color-bg-canvas);\n  font-family: var(--font-family-sans);\n  color: var(--color-text-primary);\n}\n\n/* ---- Left brand panel ---- */\n.auth-brand {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  gap: var(--space-section-gap);\n  padding: clamp(2rem, 4vw, 4rem);\n  color: var(--color-text-on-primary);\n  background:\n    radial-gradient(120% 120% at 0% 0%, var(--color-bg-primary-hover) 0%, transparent 55%),\n    linear-gradient(155deg, var(--color-bg-primary-default) 0%, var(--color-bg-primary-pressed) 100%);\n  overflow: hidden;\n}\n\n.auth-brand::after {\n  content: \"\";\n  position: absolute;\n  right: -25%;\n  bottom: -20%;\n  width: 60%;\n  height: 60%;\n  border-radius: var(--radius-full);\n  background: var(--color-bg-primary-weak);\n  opacity: 0.12;\n  pointer-events: none;\n}\n\n.auth-brand__top,\n.auth-brand__bottom {\n  position: relative;\n  z-index: 1;\n}\n\n.auth-brand__logo {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-inline-sm);\n  font-family: var(--font-family-brand);\n  font-size: var(--text-h3);\n  font-weight: var(--weight-bold);\n  letter-spacing: -0.01em;\n}\n\n.auth-brand__logo-mark {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border-radius: var(--radius-md);\n  background: var(--color-text-on-primary);\n  color: var(--color-bg-primary-default);\n}\n\n.auth-brand__headline {\n  font-size: var(--text-h1);\n  font-weight: var(--weight-bold);\n  line-height: var(--leading-tight);\n  margin: 0 0 var(--space-stack-sm);\n  letter-spacing: -0.02em;\n}\n\n.auth-brand__subhead {\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-relaxed);\n  margin: 0;\n  max-width: 38ch;\n  color: var(--color-bg-primary-weak);\n}\n\n.auth-brand__features {\n  list-style: none;\n  margin: var(--space-stack-lg) 0 0;\n  padding: 0;\n  display: grid;\n  gap: var(--space-stack-sm);\n}\n\n.auth-brand__features li {\n  display: flex;\n  align-items: center;\n  gap: var(--space-inline-sm);\n  font-size: var(--text-body);\n}\n\n.auth-brand__feature-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  border-radius: var(--radius-sm);\n  background: var(--color-text-on-primary);\n  color: var(--color-bg-primary-default);\n  flex-shrink: 0;\n}\n\n.auth-brand__quote {\n  font-size: var(--text-body);\n  line-height: var(--leading-relaxed);\n  border-left: 3px solid var(--color-bg-primary-weak);\n  padding-left: var(--space-inline-md);\n  color: var(--color-bg-primary-weak);\n}\n\n.auth-brand__quote-author {\n  display: block;\n  margin-top: var(--space-stack-xs);\n  font-size: var(--text-caption);\n  font-weight: var(--weight-semibold);\n  opacity: 0.9;\n}\n\n/* ---- Right form panel ---- */\n.auth-form-panel {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: clamp(1.5rem, 4vw, 4rem);\n  overflow-y: auto;\n}\n\n.auth-mobile-brand {\n  display: none;\n  align-items: center;\n  gap: var(--space-inline-sm);\n  margin-bottom: var(--space-stack-lg);\n  font-family: var(--font-family-brand);\n  font-weight: var(--weight-bold);\n  font-size: var(--text-h4);\n  color: var(--color-bg-primary-default);\n}\n\n.auth-mobile-brand__mark {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 34px;\n  height: 34px;\n  border-radius: var(--radius-sm);\n  background: var(--color-bg-primary-default);\n  color: var(--color-text-on-primary);\n}\n\n.auth-card {\n  width: 100%;\n  max-width: 440px;\n}\n\n.auth-card__header {\n  margin-bottom: var(--space-stack-lg);\n}\n\n.auth-card__eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-inline-xs);\n  font-size: var(--text-caption);\n  font-weight: var(--weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: var(--tracking-wide, 0.06em);\n  color: var(--color-text-secondary);\n  margin-bottom: var(--space-stack-xs);\n}\n\n.auth-card__title {\n  font-size: var(--text-h2);\n  font-weight: var(--weight-bold);\n  line-height: var(--leading-tight);\n  margin: 0 0 var(--space-stack-xs);\n  letter-spacing: -0.01em;\n}\n\n.auth-card__subtitle {\n  font-size: var(--text-body);\n  color: var(--color-text-secondary);\n  line-height: var(--leading-relaxed);\n  margin: 0;\n}\n\n.auth-card__subtitle a {\n  color: var(--color-primary);\n  font-weight: var(--weight-semibold);\n}\n\n.auth-fields {\n  display: grid;\n  gap: var(--space-stack-md);\n  margin-top: var(--space-stack-lg);\n}\n\n.auth-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-inline-md);\n  flex-wrap: wrap;\n}\n\n.auth-link {\n  color: var(--color-primary);\n  font-weight: var(--weight-semibold);\n  font-size: var(--text-body-sm);\n  text-decoration: none;\n}\n\n.auth-link:hover {\n  text-decoration: underline;\n}\n\n.auth-submit {\n  margin-top: var(--space-stack-md);\n}\n\n.auth-consent {\n  font-size: var(--text-caption);\n  color: var(--color-text-secondary);\n  line-height: var(--leading-relaxed);\n  margin-top: var(--space-stack-md);\n}\n\n.auth-consent a {\n  color: var(--color-primary);\n  font-weight: var(--weight-semibold);\n}\n\n.auth-divider {\n  display: flex;\n  align-items: center;\n  gap: var(--space-inline-md);\n  margin: var(--space-stack-lg) 0;\n  color: var(--color-text-secondary);\n  font-size: var(--text-caption);\n}\n\n.auth-divider::before,\n.auth-divider::after {\n  content: \"\";\n  flex: 1;\n  height: 1px;\n  background: var(--color-border-default);\n}\n\n.auth-social {\n  display: grid;\n  gap: var(--space-stack-sm);\n}\n\n.auth-social__btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-inline-sm);\n  width: 100%;\n  height: 44px;\n  border-radius: var(--radius-input);\n  border: var(--border-width-thin, 1px) solid var(--color-border-default);\n  background: var(--color-bg-surface-default);\n  color: var(--color-text-primary);\n  font-family: var(--font-family-sans);\n  font-size: var(--text-body-sm);\n  font-weight: var(--weight-semibold);\n  cursor: pointer;\n  transition: background var(--duration-fast) var(--easing-standard),\n    border-color var(--duration-fast) var(--easing-standard);\n}\n\n.auth-social__btn:hover {\n  background: var(--color-bg-surface-muted);\n  border-color: var(--color-border-strong);\n}\n\n.auth-social__btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 3px var(--color-focus-ring);\n  outline-offset: var(--focus-ring-offset, 2px);\n}\n\n.auth-social__btn:disabled {\n  opacity: var(--opacity-disabled);\n  cursor: not-allowed;\n}\n\n.auth-alt {\n  margin-top: var(--space-stack-lg);\n  text-align: center;\n  font-size: var(--text-body-sm);\n  color: var(--color-text-secondary);\n}\n\n.auth-alt a {\n  color: var(--color-primary);\n  font-weight: var(--weight-semibold);\n  text-decoration: none;\n}\n\n.auth-alt a:hover {\n  text-decoration: underline;\n}\n\n/* ---- OTP ---- */\n.auth-otp {\n  margin-top: var(--space-stack-md);\n}\n\n.auth-otp__meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-inline-sm);\n  margin-top: var(--space-stack-sm);\n  font-size: var(--text-caption);\n  color: var(--color-text-secondary);\n}\n\n.auth-otp__resend {\n  background: none;\n  border: none;\n  padding: 0;\n  color: var(--color-primary);\n  font-weight: var(--weight-semibold);\n  font-size: var(--text-caption);\n  cursor: pointer;\n  font-family: inherit;\n}\n\n.auth-otp__resend:disabled {\n  color: var(--color-text-disabled);\n  cursor: not-allowed;\n}\n\n.auth-otp__resend:not(:disabled):hover {\n  text-decoration: underline;\n}\n\n/* ---- Centered status / error screens ---- */\n.auth-status {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-page-x);\n  background: var(--color-bg-canvas);\n  font-family: var(--font-family-sans);\n}\n\n.auth-status__inner {\n  width: 100%;\n  max-width: 480px;\n  text-align: center;\n  background: var(--color-bg-surface-default);\n  border-radius: var(--radius-card);\n  box-shadow: var(--shadow-3);\n  padding: clamp(1.75rem, 4vw, 3rem);\n}\n\n.auth-status__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 64px;\n  height: 64px;\n  border-radius: var(--radius-full);\n  margin-bottom: var(--space-stack-md);\n}\n\n.auth-status__icon--info { background: var(--color-bg-primary-weak); color: var(--color-bg-primary-default); }\n.auth-status__icon--success { background: var(--color-bg-success-subtle); color: var(--color-success-600); }\n.auth-status__icon--warning { background: var(--color-bg-warning-subtle); color: var(--color-warning-600); }\n.auth-status__icon--danger { background: var(--color-danger-50); color: var(--color-danger-600); }\n\n.auth-status__title {\n  font-size: var(--text-h3);\n  font-weight: var(--weight-bold);\n  margin: 0 0 var(--space-stack-xs);\n}\n\n.auth-status__body {\n  font-size: var(--text-body);\n  color: var(--color-text-secondary);\n  line-height: var(--leading-relaxed);\n  margin: 0 0 var(--space-stack-lg);\n}\n\n.auth-status__actions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-stack-sm);\n  align-items: stretch;\n}\n\n.auth-status__actions .auth-link-row {\n  margin-top: var(--space-stack-xs);\n  font-size: var(--text-body-sm);\n  color: var(--color-text-secondary);\n}\n\n.auth-spinner {\n  width: 28px;\n  height: 28px;\n  border: 3px solid var(--color-border-default);\n  border-top-color: var(--color-bg-primary-default);\n  border-radius: var(--radius-full);\n  animation: auth-spin 0.8s linear infinite;\n}\n\n@keyframes auth-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* ---- Success check animation ---- */\n.auth-check {\n  stroke-dasharray: 48;\n  stroke-dashoffset: 48;\n  animation: auth-draw 0.5s var(--easing-standard) forwards;\n}\n\n@keyframes auth-draw {\n  to { stroke-dashoffset: 0; }\n}\n\n.auth-shake {\n  animation: auth-shake 0.4s var(--easing-standard);\n}\n\n@keyframes auth-shake {\n  0%, 100% { transform: translateX(0); }\n  20%, 60% { transform: translateX(-6px); }\n  40%, 80% { transform: translateX(6px); }\n}\n\n/* ---- Inline form alert ---- */\n.auth-alert {\n  display: flex;\n  gap: var(--space-inline-sm);\n  align-items: flex-start;\n  padding: var(--space-stack-sm) var(--space-inline-md);\n  border-radius: var(--radius-input);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-normal);\n  margin-top: var(--space-stack-sm);\n}\n\n.auth-alert--error {\n  background: var(--color-danger-50);\n  color: var(--color-danger-700);\n}\n\n.auth-alert--success {\n  background: var(--color-success-50);\n  color: var(--color-success-700);\n}\n\n.auth-alert--info {\n  background: var(--color-bg-primary-weak);\n  color: var(--color-text-accent);\n}\n\n.auth-alert__icon {\n  flex-shrink: 0;\n  margin-top: 1px;\n}\n\n/* ---- Responsive ---- */\n@media (max-width: 900px) {\n  .auth-shell {\n    grid-template-columns: 1fr;\n  }\n  .auth-brand {\n    display: none;\n  }\n  .auth-mobile-brand {\n    display: inline-flex;\n  }\n}\n\n@media (max-width: 380px) {\n  .auth-form-panel {\n    padding: var(--space-stack-md);\n  }\n}\n\n/* ---- Reduced motion ---- */\n@media (prefers-reduced-motion: reduce) {\n  .auth-spinner,\n  .auth-check,\n  .auth-shake {\n    animation: none;\n  }\n  .auth-check {\n    stroke-dashoffset: 0;\n  }\n}\n\n/* ---- Preview scaffold ---- */\n.auth-preview {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: var(--space-page-y) var(--space-page-x);\n  font-family: var(--font-family-sans);\n  color: var(--color-text-primary);\n}\n\n.auth-preview__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-inline-md);\n  flex-wrap: wrap;\n  margin-bottom: var(--space-stack-lg);\n}\n\n.auth-preview__title {\n  font-size: var(--text-h2);\n  font-weight: var(--weight-bold);\n  margin: 0 0 var(--space-stack-xs);\n}\n\n.auth-preview__subtitle {\n  font-size: var(--text-body);\n  color: var(--color-text-secondary);\n  margin: 0;\n  max-width: 70ch;\n}\n\n.auth-preview__badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-inline-xs);\n  padding: 6px 12px;\n  border-radius: var(--radius-pill);\n  font-size: var(--text-caption);\n  font-weight: var(--weight-semibold);\n  background: var(--color-bg-warning-subtle);\n  color: var(--color-warning-700);\n  border: var(--border-width-thin, 1px) solid var(--color-border-default);\n  white-space: nowrap;\n}\n\n.auth-preview__devices {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: var(--space-stack-lg);\n  margin-bottom: var(--space-section-gap);\n}\n\n.auth-preview__device {\n  margin: 0;\n  border: var(--border-width-thin, 1px) solid var(--color-border-default);\n  border-radius: var(--radius-card);\n  overflow: hidden;\n  background: var(--color-bg-surface-default);\n  box-shadow: var(--shadow-1);\n}\n\n.auth-preview__device figcaption {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--space-stack-xs) var(--space-inline-md);\n  font-size: var(--text-caption);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text-secondary);\n  border-bottom: var(--border-width-thin, 1px) solid var(--color-border-default);\n  background: var(--color-bg-surface-muted);\n}\n\n.auth-preview__frame {\n  display: block;\n  width: 100%;\n  height: 760px;\n  border: 0;\n  background: var(--color-bg-canvas);\n}\n\n.auth-preview__notes {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: var(--space-stack-lg);\n  margin-top: var(--space-stack-lg);\n}\n\n.auth-preview__note {\n  background: var(--color-bg-surface-default);\n  border: var(--border-width-thin, 1px) solid var(--color-border-default);\n  border-radius: var(--radius-card);\n  padding: var(--space-stack-md) var(--space-inline-md);\n}\n\n.auth-preview__note h3 {\n  font-size: var(--text-body);\n  font-weight: var(--weight-bold);\n  margin: 0 0 var(--space-stack-xs);\n}\n\n.auth-preview__note ul {\n  margin: 0;\n  padding-left: 1.1rem;\n  font-size: var(--text-body-sm);\n  color: var(--color-text-secondary);\n  line-height: var(--leading-relaxed);\n}\n\n.auth-skip {\n  position: absolute;\n  left: 8px;\n  top: -48px;\n  background: var(--color-bg-surface-default);\n  border: var(--border-width-thin, 1px) solid var(--color-border-default);\n  padding: 8px 12px;\n  border-radius: var(--radius-sm);\n  z-index: 1000;\n  transition: top 0.15s ease;\n}\n.auth-skip:focus {\n  top: 8px;\n}\n"]],[[1,16]],["BODY",{},[[1,17]],["DIV",{"id":"root"},["A",{"href":"#main","class":"sk-skip"},"Skip to content"],["DIV",{"class":"auth-shell"},["ASIDE",{"class":